# Copy this file to .env and fill in real values. Never commit .env.
# NASA Earthdata token (only the Python backend/data scripts read this)
EARTHDATA_TOKEN=your_token_here
# USDA NASS Quick Stats API key (backend only; request one at https://quickstats.nass.usda.gov/api)
NASS_QUICKSTATS_API_KEY=your_key_here
# Hugging Face read token for the raster dataset (backend only)
HF_TOKEN=your_hugging_face_read_token

# SerpApi key for the "Ask about this field" chat (backend only; https://serpapi.com/manage-api-key)
SERPAPI_API_KEY=your_serpapi_key_here

# ElevenLabs key for the chat's Listen and microphone buttons (backend only; https://elevenlabs.io/app/settings/api-keys)
ELEVENLABS_API_KEY=your_elevenlabs_key_here
