{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://farmers-helpers.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://farmers-helpers.onrender.com/health"
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/(.*\\.(js|css|ico|png|jpg|svg|woff2?))",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
